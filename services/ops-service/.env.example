# Ops Service — chaos + observability control plane (defaults shown; .env is optional for local dev)
PORT=4004
SERVICE_VERSION=1.0.0
LOG_LEVEL=info

# OpenTelemetry — leave empty to disable tracing export locally
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=

# Comma separated "name:port" list of the services observed by the ops plane.
# Base URLs are taken from <NAME>_SERVICE_URL when set (e.g. PRODUCT_SERVICE_URL),
# otherwise http://127.0.0.1:<port> locally and http://<name>:<port> in-cluster.
SERVICES=user-service:4001,product-service:4002,order-service:4003
USER_SERVICE_URL=http://127.0.0.1:4001
PRODUCT_SERVICE_URL=http://127.0.0.1:4002
ORDER_SERVICE_URL=http://127.0.0.1:4003

# Prometheus (optional — the service silently falls back to scraping /metrics itself)
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:16686

# Background scraping of every service's /metrics endpoint
METRICS_POLL_INTERVAL_MS=5000
METRICS_HISTORY_POINTS=1800

# Chaos experiments — keep CHAOS_ENABLED=false outside local/lab environments.
# CHAOS_MODE: 'local' (POST /internal/fault on the target service) or 'k8s'
# (Istio VirtualService fault injection via kubectl; CHAOS_DEFAULT_PROVIDER picks
# 'istio' or 'chaos-mesh' when a request says provider='auto').
CHAOS_ENABLED=false
CHAOS_MODE=local
CHAOS_DEFAULT_PROVIDER=istio
CHAOS_ALLOW_PATTERN=minikube|kind|desktop|docker-desktop|localhost
CHAOS_NAMESPACE=ecommerce
KUBECTL_BIN=kubectl

# Enables POST/GET/DELETE /internal/fault on THIS service (not needed for the ops plane itself)
FAULT_INJECTION_ENABLED=false

# Comma separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
