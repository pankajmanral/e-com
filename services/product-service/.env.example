# Product Service (defaults shown; .env is optional for local dev)
PORT=4002
SERVICE_VERSION=1.0.0
LOG_LEVEL=info

# OpenTelemetry — leave empty to disable tracing export locally
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=

# Enables POST/GET/DELETE /internal/fault (local lab mode only, keep false elsewhere)
FAULT_INJECTION_ENABLED=true

# Comma separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
