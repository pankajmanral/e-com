# User Service (defaults shown; .env is optional for local dev)
PORT=4001
SERVICE_VERSION=1.0.0
LOG_LEVEL=info

# OpenTelemetry — 'none' keeps trace ids/propagation without exporting anything;
# set OTEL_TRACES_EXPORTER=otlp + OTEL_EXPORTER_OTLP_ENDPOINT to send spans to a collector
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=

# Enables POST/GET/DELETE /internal/fault (local lab mode only, keep false elsewhere)
FAULT_INJECTION_ENABLED=true

# --- MongoDB (primary datastore) ---
# Leave empty to use the seeded in-memory fallback store (dependency-free dev mode).
# Example: MONGODB_URI=mongodb://localhost:27017
MONGODB_URI=
# Database name (default: vantage_user_service)
MONGODB_DB=
# true = refuse to boot when MongoDB is unreachable
MONGODB_REQUIRED=false
# Server selection timeout in ms (default 3000)
MONGODB_TIMEOUT_MS=3000

# Comma separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
