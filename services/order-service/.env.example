# Order Service (defaults shown; .env is optional for local dev)
PORT=4003
SERVICE_VERSION=1.0.0
LOG_LEVEL=info

# Upstream services used during checkout
USER_SERVICE_URL=http://localhost:4001
PRODUCT_SERVICE_URL=http://localhost:4002

# Per-request upstream timeout for the shared ServiceClient (ms)
UPSTREAM_TIMEOUT_MS=3000

# JSON persistence of placed orders (defaults to <service>/data/orders.json)
ORDERS_FILE=

# OpenTelemetry — leave empty to disable tracing export locally
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=

# Enables POST/GET/DELETE /internal/fault (local lab mode only, keep false elsewhere)
FAULT_INJECTION_ENABLED=true

# Comma separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
