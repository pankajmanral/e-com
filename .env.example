# ---------------------------------------------------------------------------
# Service-Mesh Resilience Lab — root environment example
# Copy to `.env` (docker compose) and adjust. Individual services also read
# their own variables — see services/*/.env.example.
# ---------------------------------------------------------------------------

# --- Service endpoints (local development mode) ---
USER_SERVICE_URL=http://localhost:4001
PRODUCT_SERVICE_URL=http://localhost:4002
ORDER_SERVICE_URL=http://localhost:4003
OPS_SERVICE_URL=http://localhost:4004

# Origin allowed to call the services directly (Next.js usually proxies instead)
CORS_ORIGIN=http://localhost:3000

# --- Observability ---
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to keep tracing self-contained
# (real trace ids + propagation, but nothing is exported — ideal for `npm run dev`).
# Docker Compose / Kubernetes set this to the OpenTelemetry collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
# none (context only) | otlp (export to collector) | console (debug) | disabled (no SDK)
OTEL_TRACES_EXPORTER=none
LOG_LEVEL=info

# Prometheus used by the ops-service for resilience metrics
PROMETHEUS_URL=http://localhost:9090

# --- Chaos engineering guards ---
# Chaos controls are disabled unless explicitly enabled AND the target
# environment is a local test cluster (minikube / kind / Docker Desktop).
CHAOS_ENABLED=false
# local  = fault-injection endpoints on each service (no cluster needed)
# k8s    = Chaos Mesh / Istio fault injection via kubectl
CHAOS_MODE=local
# kubectl context pattern allowed to receive chaos experiments
CHAOS_ALLOW_PATTERN=minikube|kind|desktop|docker-desktop|localhost

# --- MongoDB (primary datastore for every service) ---
# Leave empty to run dependency-free: each service falls back to its seeded
# in-memory / JSON-file store (lightweight dev mode).
# Docker Compose / Kubernetes set this to mongodb://mongodb:27017
MONGODB_URI=
# Per-service default when unset: vantage_user_service, vantage_product_service,
# vantage_order_service, vantage_ops_service
MONGODB_DB=
# true = a service refuses to boot when MongoDB is unreachable (use in compose/k8s)
MONGODB_REQUIRED=false
MONGODB_TIMEOUT_MS=3000
